{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpsLog",
  "version": "3.0.7",
  "identifier": "com.murong.opslog",
  "build": {
    "frontendDist": "../dist-web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "title": "OpsLog 日志工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "M5/Faulu 日志查询工作台",
    "longDescription": "通过本机 VPN 安全访问 Kibana 的跨平台日志查询工具",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
