{
  "name": "opslog-web",
  "version": "3.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"tsx watch server/index.ts\" \"npm run web:dev\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "web:dev": "vite",
    "web:build": "vite build",
    "start": "node dist-server/server/index.js",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:macos": "tauri build --bundles app,dmg",
    "desktop:windows": "tauri build --no-bundle",
    "desktop:portable": "npm run desktop:windows",
    "desktop:info": "tauri info",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.0"
  }
}
